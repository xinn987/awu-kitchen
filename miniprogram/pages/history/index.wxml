<view class="page-shell">
  <page-navbar left-text="食谱详情" title="修订记录" subtitle="{{recipeName}}" bindleft="back"></page-navbar>
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <app-loading wx:if="{{loading}}" label="正在加载修订记录"></app-loading>
    <view wx:elif="{{!found}}" class="empty-state">没有找到这份食谱</view>
    <view wx:elif="{{revisions.length === 0}}" class="empty-state">
      <app-icon name="type-plate" size="120"></app-icon>
      <text>还没有修订记录，第一次保存后会出现在这里</text>
    </view>
    <view wx:else class="timeline">
      <view wx:for="{{revisions}}" wx:key="id" class="revision-row">
        <view wx:if="{{index < revisions.length - 1}}" class="timeline-line"></view>
        <view class="timeline-dot {{item.isCurrent ? 'current' : ''}}">
          <app-icon name="{{item.isCurrent ? 'clock' : 'rotate'}}" size="28"></app-icon>
        </view>
        <view class="revision-body">
          <view class="revision-author">
            <member-avatar name="{{item.authorName}}" size="38" color="{{item.avatarColor}}"></member-avatar>
            <text class="author-name">{{item.authorName}}</text>
            <text wx:if="{{item.isCurrent}}" class="current-badge">当前版本</text>
          </view>
          <text class="revision-time">{{item.dateLabel}} · {{item.relativeLabel}}</text>
          <text class="revision-summary">{{item.summary}}</text>

          <view wx:if="{{item.sameAsCurrent}}" class="snapshot-same">成功关键与当前版本相同</view>
          <view wx:elif="{{item.visibleKeys.length > 0}}" class="snapshot">
            <text class="snapshot-label">该版本的成功关键</text>
            <text wx:for="{{item.visibleKeys}}" wx:for-item="key" wx:for-index="keyIndex" wx:key="index" class="snapshot-key font-serif">{{keyIndex + 1}}. {{key}}</text>
          </view>

          <view wx:if="{{!item.isCurrent}}" class="restore-row">
            <view wx:if="{{item.confirming}}" class="restore-confirm">
              <text>确认恢复到这个版本？</text>
              <view class="confirm-link" role="button" data-id="{{item.id}}" bindtap="confirmRestore">{{restoring ? '恢复中…' : '确认恢复'}}</view>
              <view class="cancel-link" role="button" bindtap="cancelRestore">取消</view>
            </view>
            <view wx:else class="restore-button" role="button" data-id="{{item.id}}" bindtap="startRestore">恢复此版本</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <app-toast visible="{{toastVisible}}" message="{{toastMessage}}"></app-toast>
</view>
