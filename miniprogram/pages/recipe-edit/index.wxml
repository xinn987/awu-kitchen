<view class="page-shell">
  <page-navbar left-text="取消" title="编辑食谱" bindleft="cancel"></page-navbar>
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <app-loading wx:if="{{loading}}" label="正在加载食谱"></app-loading>
    <view wx:elif="{{!found}}" class="empty-state">没有找到这份食谱</view>
    <view wx:else class="edit-form">
      <!-- 名称：直接写成将来的标题样子，衬线大字、无边框。 -->
      <view class="name-block">
        <input
          class="name-input font-serif"
          value="{{name}}"
          placeholder="这道辅食叫什么？"
          placeholder-class="name-placeholder"
          bindinput="onNameInput"
        />
      </view>

      <view class="edit-section">
        <view class="section-head">
          <view class="section-label"><app-icon name="zap" size="28"></app-icon><text>成功关键</text><text class="required">*</text></view>
          <text wx:if="{{showKeysHint}}" class="keys-hint">写一条才能保存</text>
        </view>
        <view class="key-list">
          <view wx:for="{{keys}}" wx:key="index" class="key-editor">
            <textarea
              class="key-textarea"
              value="{{item}}"
              data-index="{{index}}"
              placeholder="比如：蒸到筷子能轻松穿过才够烂"
              placeholder-class="key-placeholder"
              maxlength="-1"
              auto-height
              bindinput="onKeyInput"
            ></textarea>
            <view class="remove-button" role="button" aria-label="删除成功关键" data-index="{{index}}" bindtap="removeKey">
              <app-icon name="x" size="30"></app-icon>
            </view>
          </view>
        </view>
        <view class="add-button" role="button" bindtap="addKey">
          <app-icon name="plus" size="30"></app-icon>
          <text>添加成功关键</text>
        </view>
      </view>

      <!-- 主图在成功关键之后出现，不把图片抬到核心经验之前。 -->
      <view class="edit-section">
        <view class="section-label"><app-icon name="image" size="28"></app-icon><text>主图（可选）</text></view>
        <view wx:if="{{mainImage}}" class="main-image-editor">
          <image class="main-image-preview" src="{{mainImage.localPath}}" mode="aspectFill"></image>
          <view class="image-action-row">
            <text class="image-link" role="button" bindtap="chooseMainImage">更换</text>
            <text class="image-link danger" role="button" bindtap="removeMainImage">移除</text>
          </view>
        </view>
        <view wx:else class="image-empty" role="button" bindtap="chooseMainImage">
          <view class="image-empty-icon"><app-icon name="image" size="38"></app-icon></view>
          <view>
            <text class="image-empty-title">添加主图</text>
            <text class="image-empty-copy">记录做成后的样子</text>
          </view>
        </view>
      </view>

      <!-- —— 食材：点亮星标即主食材，行式编辑、细分隔线 —— -->
      <view class="edit-section">
        <view class="section-head" role="button" data-section="ingredients" bindtap="toggleSection">
          <view class="section-label"><app-icon name="shopping-bag" size="28"></app-icon><text>食材</text></view>
          <view class="collapse-meta">
            <text wx:if="{{ingredientsCount > 0}}" class="collapse-count">{{ingredientsCount}} 项</text>
            <text wx:else class="collapse-add">添加</text>
            <view class="collapse-chevron {{sections.ingredients ? 'open' : ''}}"><app-icon name="chevron-down" size="26"></app-icon></view>
          </view>
        </view>
        <block wx:if="{{sections.ingredients}}">
          <view class="ingredient-list">
            <view wx:for="{{ingredients}}" wx:key="index" class="ingredient-row">
              <view
                class="primary-toggle {{item.primary ? 'on' : ''}}"
                role="button"
                aria-label="{{item.primary ? '取消主食材' : '标记主食材'}}"
                data-index="{{index}}"
                bindtap="togglePrimary"
              >
                <app-icon name="{{item.primary ? 'star-filled' : 'star'}}" size="34"></app-icon>
              </view>
              <input class="ingredient-name" value="{{item.name}}" placeholder="食材名" placeholder-class="row-placeholder" data-index="{{index}}" data-field="name" bindinput="onIngredientInput" />
              <input class="ingredient-amount" value="{{item.amount}}" placeholder="用量" placeholder-class="row-placeholder" data-index="{{index}}" data-field="amount" bindinput="onIngredientInput" />
              <view class="remove-button" role="button" aria-label="删除食材" data-index="{{index}}" bindtap="removeIngredient">
                <app-icon name="x" size="30"></app-icon>
              </view>
            </view>
          </view>
          <view class="primary-help">点亮星标的食材会作为这道菜的主食材，方便家人按原料查找。</view>
          <view wx:if="{{ingredientSuggestions.length > 0}}" class="suggestion-block">
            <text class="suggestion-label">全家常用</text>
            <view class="suggestion-row">
              <view wx:for="{{ingredientSuggestions}}" wx:key="*this" class="suggestion-chip" role="button" data-name="{{item}}" bindtap="addSuggestedIngredient">
                <app-icon name="plus" size="24"></app-icon><text>{{item}}</text>
              </view>
            </view>
          </view>
          <view class="add-button" role="button" bindtap="addIngredient">
            <app-icon name="plus" size="30"></app-icon>
            <text>添加食材</text>
          </view>
        </block>
      </view>

      <!-- —— 步骤：无框文本直接编辑，序号与图片归属每步 —— -->
      <view class="edit-section">
        <view class="section-head" role="button" data-section="steps" bindtap="toggleSection">
          <view class="section-label"><app-icon name="list" size="28"></app-icon><text>步骤</text></view>
          <view class="collapse-meta">
            <text wx:if="{{stepsCount > 0}}" class="collapse-count">{{stepsCount}} 步</text>
            <text wx:else class="collapse-add">添加</text>
            <view class="collapse-chevron {{sections.steps ? 'open' : ''}}"><app-icon name="chevron-down" size="26"></app-icon></view>
          </view>
        </view>
        <block wx:if="{{sections.steps}}">
          <view class="step-list">
            <view wx:for="{{steps}}" wx:key="id" class="step-block">
              <view class="step-head">
                <text class="step-number">{{index + 1}}</text>
                <view class="step-tools">
                  <view
                    wx:if="{{index > 0}}"
                    class="step-tool"
                    role="button"
                    aria-label="上移"
                    data-index="{{index}}"
                    data-offset="-1"
                    bindtap="moveStep"
                  ><app-icon name="arrow-up" size="30"></app-icon></view>
                  <view
                    wx:if="{{index < steps.length - 1}}"
                    class="step-tool"
                    role="button"
                    aria-label="下移"
                    data-index="{{index}}"
                    data-offset="1"
                    bindtap="moveStep"
                  ><app-icon name="arrow-down" size="30"></app-icon></view>
                  <view class="step-tool danger" role="button" aria-label="删除这一步" data-index="{{index}}" bindtap="removeStep">
                    <app-icon name="x" size="30"></app-icon>
                  </view>
                </view>
              </view>
              <textarea
                class="step-textarea"
                value="{{item.text}}"
                data-index="{{index}}"
                placeholder="这一步做什么？做到什么状态算到位"
                placeholder-class="row-placeholder"
                maxlength="-1"
                auto-height
                bindinput="onStepTextInput"
              ></textarea>
              <view wx:if="{{item.image}}" class="step-image-editor">
                <image class="step-image-preview" src="{{item.image.localPath}}" mode="aspectFill"></image>
                <view class="image-action-row compact">
                  <text class="image-link" role="button" data-index="{{index}}" bindtap="chooseStepImage">更换</text>
                  <text class="image-link danger" role="button" data-index="{{index}}" bindtap="removeStepImage">移除</text>
                </view>
              </view>
              <view wx:else class="step-image-add" role="button" data-index="{{index}}" bindtap="chooseStepImage">
                <app-icon name="image" size="28"></app-icon><text>添加步骤图</text>
              </view>
            </view>
            <view wx:if="{{steps.length === 0}}" class="steps-empty">还没有步骤，按做的顺序写下来</view>
          </view>
          <view class="add-button" role="button" bindtap="addStep">
            <app-icon name="plus" size="30"></app-icon>
            <text>添加一步</text>
          </view>
        </block>
      </view>

      <!-- —— 分类：家庭统一维护的两个单选组 —— -->
      <view class="edit-section last">
        <view class="section-head" role="button" data-section="classify" bindtap="toggleSection">
          <view class="section-label"><app-icon name="tag" size="28"></app-icon><text>分类</text></view>
          <view class="collapse-meta">
            <text wx:if="{{classifySummary}}" class="collapse-count">{{classifySummary}}</text>
            <text wx:else class="collapse-add">添加</text>
            <view class="collapse-chevron {{sections.classify ? 'open' : ''}}"><app-icon name="chevron-down" size="26"></app-icon></view>
          </view>
        </view>
        <block wx:if="{{sections.classify}}">
          <view class="classify-group">
            <text class="classify-label">辅食类型</text>
            <view class="option-row">
              <view wx:for="{{typeOptions}}" wx:key="label" class="option-chip {{item.active ? 'active' : ''}}" role="button" data-value="{{item.label}}" bindtap="selectType">{{item.label}}</view>
            </view>
          </view>
          <view class="classify-group">
            <text class="classify-label">适用阶段</text>
            <view class="option-row">
              <view wx:for="{{stageOptions}}" wx:key="label" class="option-chip {{item.active ? 'active' : ''}}" role="button" data-value="{{item.label}}" bindtap="selectStage">{{item.label}}</view>
            </view>
          </view>
          <view class="classify-note">选项由家庭共同维护，可在「设置 · 食谱选项」中调整。</view>
        </block>
      </view>
    </view>
  </scroll-view>

  <!-- 保存栏固定在页面底部，长表单滚动时始终可见。 -->
  <view wx:if="{{found && !loading}}" class="action-bar">
    <button class="primary-button save-button {{!canSave || saving ? 'disabled' : ''}}" hover-class="none" aria-label="保存食谱修改" catchtap="save">{{saving ? saveStatus : ('保存' + (formalizing ? '并转为正式食谱' : '修改'))}}</button>
  </view>

  <confirm-panel
    visible="{{confirmVisible}}"
    title="{{confirmTitle}}"
    copy="{{confirmCopy}}"
    note="{{confirmNote}}"
    confirm-text="{{confirmText}}"
    cancel-text="{{confirmCancelText}}"
    danger="{{confirmDanger}}"
    cancelable="{{confirmCancelable}}"
    bindconfirm="onConfirm"
    bindcancel="onCancelConfirm"
  ></confirm-panel>
</view>
