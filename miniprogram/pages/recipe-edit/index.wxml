<view class="page-shell">
  <page-navbar left-text="取消" title="编辑食谱" bindleft="cancel"></page-navbar>
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{!found}}" class="empty-state">没有找到这份食谱</view>
    <view wx:else class="edit-form">
      <view class="form-section">
        <view class="field-label">食谱名称</view>
        <input class="field-input name-field" value="{{name}}" bindinput="onNameInput" />
      </view>

      <view class="form-section">
        <view class="section-head">
          <view class="section-label"><app-icon name="zap" size="28"></app-icon><text>成功关键</text><text class="required">*</text></view>
          <text wx:if="{{showKeysHint}}" class="keys-hint">写一条才能保存</text>
        </view>
        <view class="repeat-list">
          <view wx:for="{{keys}}" wx:key="index" class="key-editor">
            <view class="key-accent"></view>
            <textarea
              class="field-textarea key-textarea"
              value="{{item}}"
              data-index="{{index}}"
              placeholder="比如：蒸到筷子能轻松穿过才够烂"
              placeholder-class="field-placeholder"
              maxlength="-1"
              auto-height
              bindinput="onKeyInput"
            ></textarea>
            <view class="remove-button" role="button" aria-label="删除成功关键" data-index="{{index}}" bindtap="removeKey">
              <app-icon name="x" size="32"></app-icon>
            </view>
          </view>
        </view>
        <view class="add-button" role="button" bindtap="addKey">
          <app-icon name="plus" size="30"></app-icon>
          <text>添加成功关键</text>
        </view>
      </view>

      <!-- —— 食材：常用点选 + 名称/用量两框 —— -->
      <view class="form-section">
        <view class="section-head" role="button" data-section="ingredients" bindtap="toggleSection">
          <view class="section-label"><app-icon name="shopping-bag" size="28"></app-icon><text>食材</text></view>
          <view class="collapse-meta">
            <text wx:if="{{ingredientsCount > 0}}" class="collapse-count">{{ingredientsCount}} 项</text>
            <text wx:else class="collapse-add">添加</text>
            <view class="collapse-chevron {{sections.ingredients ? 'open' : ''}}"><app-icon name="chevron-down" size="26"></app-icon></view>
          </view>
        </view>
        <block wx:if="{{sections.ingredients}}">
          <view wx:if="{{ingredientSuggestions.length > 0}}" class="suggestion-block">
            <text class="suggestion-label">全家常用</text>
            <view class="suggestion-row">
              <view wx:for="{{ingredientSuggestions}}" wx:key="*this" class="suggestion-chip" role="button" data-name="{{item}}" bindtap="addSuggestedIngredient">
                <app-icon name="plus" size="24"></app-icon><text>{{item}}</text>
              </view>
            </view>
          </view>

          <view class="repeat-list">
            <view wx:for="{{ingredients}}" wx:key="index" class="ingredient-editor">
              <input class="field-input ingredient-name" value="{{item.name}}" placeholder="食材名" placeholder-class="field-placeholder" data-index="{{index}}" data-field="name" bindinput="onIngredientInput" />
              <input class="field-input amount-input" value="{{item.amount}}" placeholder="用量" placeholder-class="field-placeholder" data-index="{{index}}" data-field="amount" bindinput="onIngredientInput" />
              <view class="remove-button" role="button" aria-label="删除食材" data-index="{{index}}" bindtap="removeIngredient">
                <app-icon name="x" size="32"></app-icon>
              </view>
            </view>
          </view>
          <view class="add-button" role="button" bindtap="addIngredient">
            <app-icon name="plus" size="30"></app-icon>
            <text>添加食材</text>
          </view>
        </block>
      </view>

      <!-- —— 步骤：纯阅读列表 + 单框录入，编辑操作集中出现 —— -->
      <view class="form-section">
        <view class="section-head" role="button" data-section="steps" bindtap="toggleSection">
          <view class="section-label"><app-icon name="list" size="28"></app-icon><text>步骤</text></view>
          <view class="collapse-meta">
            <text wx:if="{{stepsCount > 0}}" class="collapse-count">{{stepsCount}} 步</text>
            <text wx:else class="collapse-add">添加</text>
            <view class="collapse-chevron {{sections.steps ? 'open' : ''}}"><app-icon name="chevron-down" size="26"></app-icon></view>
          </view>
        </view>
        <block wx:if="{{sections.steps}}">
          <view class="step-list">
            <view
              wx:for="{{steps}}"
              wx:key="index"
              class="step-item {{stepEditingIndex === index ? 'editing' : ''}}"
              role="button"
              aria-label="修改第 {{index + 1}} 步"
              data-index="{{index}}"
              bindtap="editStep"
            >
              <text class="step-number">{{index + 1}}</text>
              <text class="step-copy">{{item}}</text>
              <view class="step-tail"><app-icon name="chevron-right" size="26"></app-icon></view>
            </view>
            <view wx:if="{{steps.length === 0}}" class="steps-empty">还没有步骤，在下面写下第一条</view>
          </view>

          <view class="quick-add-bar step-bar">
            <textarea
              class="quick-add-textarea"
              value="{{stepDraft}}"
              placeholder="{{stepEditingIndex >= 0 ? '正在修改第 ' + (stepEditingIndex + 1) + ' 步' : '第 ' + (stepsCount + 1) + ' 步，写完点加入'}}"
              placeholder-class="field-placeholder"
              maxlength="-1"
              auto-height
              bindinput="onStepDraftInput"
              bindconfirm="commitStepDraft"
            ></textarea>
            <view class="quick-add-button {{stepDraft ? '' : 'disabled'}}" role="button" bindtap="commitStepDraft">
              {{stepEditingIndex >= 0 ? '改好' : '加入'}}
            </view>
          </view>
          <view wx:if="{{stepEditingIndex >= 0}}" class="edit-strip">
            <text class="strip-link" role="button" data-offset="-1" bindtap="moveEditingStep">上移</text>
            <text class="strip-link" role="button" data-offset="1" bindtap="moveEditingStep">下移</text>
            <text class="strip-link danger" role="button" bindtap="deleteEditingStep">删除这一步</text>
            <text class="strip-link muted" role="button" bindtap="cancelStepEdit">取消</text>
          </view>
        </block>
      </view>

      <!-- —— 分类与标签 —— -->
      <view class="form-section">
        <view class="section-head" role="button" data-section="classify" bindtap="toggleSection">
          <view class="section-label"><app-icon name="tag" size="28"></app-icon><text>分类与标签</text></view>
          <view class="collapse-meta">
            <text wx:if="{{classifyCount > 0}}" class="collapse-count">已设置</text>
            <text wx:else class="collapse-add">添加</text>
            <view class="collapse-chevron {{sections.classify ? 'open' : ''}}"><app-icon name="chevron-down" size="26"></app-icon></view>
          </view>
        </view>
        <block wx:if="{{sections.classify}}">
          <view class="classify-group">
            <text class="classify-label">辅食类型</text>
            <view class="option-row">
              <view wx:for="{{typeOptions}}" wx:key="label" class="option-chip {{item.active ? 'active' : ''}}" role="button" data-value="{{item.label}}" bindtap="selectType">{{item.label}}</view>
            </view>
          </view>
          <view class="classify-group">
            <text class="classify-label">适用阶段</text>
            <view class="option-row">
              <view wx:for="{{stageOptions}}" wx:key="label" class="option-chip {{item.active ? 'active' : ''}}" role="button" data-value="{{item.label}}" bindtap="selectStage">{{item.label}}</view>
            </view>
          </view>
          <view class="classify-group">
            <text class="classify-label">核心原料标签</text>
            <view wx:if="{{tagSuggestions.length > 0}}" class="suggestion-row classify-suggestions">
              <view wx:for="{{tagSuggestions}}" wx:key="*this" class="suggestion-chip" role="button" data-tag="{{item}}" bindtap="addSuggestedTag">
                <app-icon name="plus" size="24"></app-icon><text>{{item}}</text>
              </view>
            </view>
            <view class="tag-editor-row">
              <view wx:for="{{tags}}" wx:key="*this" class="tag-item">
                <text>{{item}}</text><view class="tag-remove" role="button" aria-label="删除标签" data-tag="{{item}}" bindtap="removeTag"><app-icon name="x" size="24"></app-icon></view>
              </view>
              <view wx:if="{{tags.length < maxTags}}" class="tag-input-wrap">
                <input value="{{tagDraft}}" placeholder="{{tags.length === 0 ? '或输入新的' : '再加一个'}}" bindinput="onTagInput" bindconfirm="addTag" />
                <view class="tag-add" role="button" aria-label="添加标签" bindtap="addTag"><app-icon name="plus" size="28"></app-icon></view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{found}}" class="action-bar">
    <!-- 真机保存使用原生 button，避免 scroll-view/输入框原生层影响点击命中。 -->
    <button class="primary-button save-button {{!canSave || saving ? 'disabled' : ''}}" hover-class="none" aria-label="保存食谱修改" bindtap="save">{{saving ? '正在保存…' : ('保存' + (formalizing ? '并转为正式食谱' : '修改'))}}</button>
  </view>
</view>
