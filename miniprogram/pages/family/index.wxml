<view class="page-shell">
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="family-content" style="padding-top: {{statusBarHeight + 20}}px;">
      <view class="family-header">
        <text class="family-title font-serif">{{familyName}}</text>
        <text class="family-meta">{{loading ? '正在找到你的家人…' : memberCount + ' 位成员 · 家庭共同维护'}}</text>
      </view>

      <app-loading wx:if="{{loading}}" label="正在加载家庭成员"></app-loading>
      <block wx:else>
        <!-- 成员：开放行 + 细分隔线，与详情页同一版式 -->
        <view class="member-list">
          <view wx:for="{{members}}" wx:key="id" class="member-row">
            <member-avatar name="{{item.name}}" size="80" color="{{item.color}}"></member-avatar>
            <view class="member-copy">
              <view class="member-title-row">
                <text class="member-name">{{item.name}}</text>
                <text wx:if="{{item.isSelf}}" class="self-label">（你）</text>
                <text wx:if="{{item.isAdmin}}" class="role-pill">管理员</text>
              </view>
              <text class="member-meta">参与了 {{item.contributionCount}} 份食谱</text>
            </view>
            <view wx:if="{{item.canRemove}}" class="remove-member" role="button" aria-label="移出成员" data-id="{{item.id}}" bindtap="askRemove">
              <app-icon name="x" size="30"></app-icon>
            </view>
          </view>
        </view>

        <!-- 邀请：一段话讲清，按钮只留一个 -->
        <view wx:if="{{canInvite}}" class="invite-block">
          <view class="section-label">邀请家人加入</view>
          <view class="invite-row">
            <text class="invite-copy">复制单次邀请码发给家人，对方粘贴即可加入{{inviteExpireLabel ? '，' + inviteExpireLabel : ''}}</text>
            <view class="invite-renew" wx:if="{{inviteToken}}" role="button" bindtap="renewInvite">{{renewingInvite ? '生成中…' : '重新生成'}}</view>
          </view>
          <view class="invite-share" role="button" bindtap="copyInvite">
            <app-icon name="copy" size="30"></app-icon>
            <text>{{renewingInvite ? '正在生成…' : (inviteToken ? '复制邀请码' : '生成并复制')}}</text>
          </view>
        </view>

        <view class="family-footnote">所有成员都能查看和编辑；食谱属于家庭共同拥有，经验仅供参考。</view>

        <view class="settings-row" role="button" aria-label="设置" bindtap="openSettings">
          <app-icon name="settings" size="30"></app-icon>
          <text class="settings-row-text">设置</text>
          <app-icon name="chevron-right" size="28"></app-icon>
        </view>
      </block>
    </view>
  </scroll-view>

  <confirm-panel
    visible="{{removingId !== ''}}"
    title="移出这位成员？"
    copy="移出后 TA 将无法访问家庭食谱；TA 记录的食谱仍属于家庭，不会被删除。"
    confirm-text="{{removing ? '正在移出…' : '确认移出'}}"
    danger
    bindconfirm="confirmRemove"
    bindcancel="cancelRemove"
  ></confirm-panel>

  <bottom-nav active="family" bindcapture="openCapture"></bottom-nav>
  <quick-capture opened="{{captureOpen}}" bindclose="closeCapture" bindsaved="onCaptured"></quick-capture>
  <app-toast visible="{{toastVisible}}" message="{{toastMessage}}"></app-toast>
</view>
