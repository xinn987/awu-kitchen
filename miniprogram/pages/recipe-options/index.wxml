<view class="page-shell">
  <page-navbar left-text="返回" title="食谱选项" subtitle="{{familyName}}" bindleft="back"></page-navbar>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="options-content">
      <text class="page-description">管理食谱编辑时可选的分类。删除后，原食谱会回到未选择状态。</text>

      <view wx:if="{{loading && foodTypes.length === 0}}" class="empty-state">正在加载食谱选项…</view>

      <view wx:else class="option-sections">
        <view class="option-section">
          <view class="section-heading">
            <text class="section-title font-serif">辅食类型</text>
            <text class="section-description">每份食谱最多选择一项</text>
          </view>

          <!-- 选项沿用首页的胶囊语言；使用数量只在真正删除时提示。 -->
          <text wx:if="{{foodTypes.length === 0}}" class="section-empty">尚未设置，食谱会保持未选择。</text>
          <view class="option-chips">
            <view wx:for="{{foodTypes}}" wx:key="name" class="option-chip">
              <text class="option-name">{{item.name}}</text>
              <view
                class="option-remove"
                role="button"
                aria-label="删除{{item.name}}"
                data-kind="foodType"
                data-name="{{item.name}}"
                data-count="{{item.usageCount}}"
                catchtap="askRemove"
              >
                <app-icon name="x" size="24"></app-icon>
              </view>
            </view>
            <view class="add-option" role="button" data-kind="foodType" bindtap="startAdd">
              <app-icon name="plus" size="24"></app-icon><text>添加</text>
            </view>
          </view>
        </view>

        <view class="shared-note">
          <app-icon name="users" size="28"></app-icon>
          <text>所有家庭成员都可以修改，变更会对全家生效。</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{addingKind}}" class="panel-backdrop" bindtap="cancelAdd"></view>
  <view wx:if="{{addingKind}}" class="action-panel">
    <text class="panel-title">添加{{addingLabel}}</text>
    <input
      class="option-input"
      value="{{draft}}"
      maxlength="20"
      focus
      confirm-type="done"
      placeholder="输入名称"
      placeholder-class="option-placeholder"
      bindinput="onDraftInput"
      bindconfirm="confirmAdd"
    />
    <view class="panel-actions">
      <view class="panel-cancel" role="button" bindtap="cancelAdd">取消</view>
      <view class="panel-confirm {{!draft || saving ? 'disabled' : ''}}" role="button" bindtap="confirmAdd">{{saving ? '添加中…' : '添加'}}</view>
    </view>
  </view>

  <confirm-panel
    visible="{{confirmKind !== ''}}"
    title="删除“{{confirmName}}”？"
    copy="{{confirmCopy}}"
    note="{{confirmNote}}"
    confirm-text="{{saving ? '删除中…' : '确认删除'}}"
    danger
    bindconfirm="confirmRemove"
    bindcancel="cancelRemove"
  ></confirm-panel>

  <app-toast visible="{{toastVisible}}" message="{{toastMessage}}"></app-toast>
</view>
