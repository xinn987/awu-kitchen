<view class="onboarding-shell" style="padding-top: {{statusBarHeight + 24}}px;">
  <view class="brand-block">
    <image class="brand-avatar" src="/assets/awu-kitchen-avatar.png" mode="aspectFit"></image>
    <text class="brand-title font-serif">阿呜厨房</text>
    <text class="brand-subtitle">把家里做成功的辅食，安静地留下来</text>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <text class="state-title">正在找到你的家庭…</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="state-card error-card">
    <text class="state-title">暂时没有连接上</text>
    <text class="state-copy">{{errorMessage}}</text>
    <view class="primary-button" role="button" bindtap="retry">重试</view>
  </view>

  <view wx:else class="form-card">
    <view wx:if="{{joining}}">
      <text class="eyebrow">家庭邀请</text>
      <text class="form-title font-serif">{{inviteFamilyName ? '加入「' + inviteFamilyName + '」' : '通过邀请码加入家庭'}}</text>
      <text class="form-copy">粘贴家庭管理员发来的邀请码，再填写家人熟悉的称谓。</text>
      <block wx:if="{{!inviteFromLink}}">
        <text class="field-label">邀请码</text>
        <input class="text-input invite-input" value="{{inviteToken}}" maxlength="200" placeholder="长按粘贴邀请码" bindinput="onInviteTokenInput" />
      </block>
    </view>
    <view wx:else>
      <text class="eyebrow">第一次使用</text>
      <text class="form-title font-serif">创建家庭食谱</text>
      <text class="form-copy">创建后你是管理员，可以通过微信邀请家人共同维护。</text>
      <text class="field-label">家庭名称</text>
      <input class="text-input" value="{{familyName}}" maxlength="40" bindinput="onFamilyNameInput" />
    </view>

    <text class="field-label">你的家庭称谓</text>
    <input class="text-input" value="{{displayName}}" maxlength="20" placeholder="如：妈妈、爸爸、奶奶" bindinput="onDisplayNameInput" />

    <view class="primary-button {{canSubmit && !saving ? '' : 'disabled'}}" role="button" bindtap="submit">
      {{saving ? '正在保存…' : (joining ? '确认加入' : '创建家庭')}}
    </view>
    <view wx:if="{{joining && !inviteFromLink}}" class="mode-switch" role="button" bindtap="chooseCreate">没有邀请码，创建新家庭</view>
    <view wx:elif="{{!joining}}" class="mode-switch" role="button" bindtap="chooseJoin">已有邀请码，加入家庭</view>
  </view>

  <text class="privacy-note">微信身份只用于识别家庭成员，不要求授权头像、昵称或手机号。</text>
  <app-toast visible="{{toastVisible}}" message="{{toastMessage}}"></app-toast>
</view>
