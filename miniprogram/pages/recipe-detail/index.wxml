<view class="page-shell">
  <page-navbar left-text="食谱库" bindleft="backToLibrary"></page-navbar>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{!found}}" class="empty-state">没有找到这份食谱</view>
    <view wx:elif="{{recipe}}" class="detail-content">
      <view class="title-section">
        <view class="title-row">
          <text class="recipe-title font-serif">{{recipe.name}}</text>
          <text wx:if="{{recipe.isDraft}}" class="draft-badge">待补充</text>
          <text wx:elif="{{recipe.type}}" class="pill title-type">{{recipe.type}}</text>
        </view>
        <view class="meta-row">
          <view class="author-row">
            <member-avatar name="{{recipe.updatedName}}" size="38" color="{{recipe.avatarColor}}"></member-avatar>
            <text>{{recipe.updatedName}} 修改于 {{recipe.updatedDate}}</text>
          </view>
          <text class="dot">·</text>
          <view class="history-link" role="button" bindtap="openHistory">
            <app-icon name="clock" size="26"></app-icon>
            <text>修订记录</text>
          </view>
        </view>
        <view wx:if="{{recipe.stage || recipe.tags.length > 0}}" class="tag-row">
          <text wx:if="{{recipe.stage}}" class="pill">{{recipe.stage}}</text>
          <text wx:for="{{recipe.tags}}" wx:key="*this" class="pill">{{item}}</text>
        </view>
      </view>

      <view class="detail-section">
        <view class="section-label"><app-icon name="zap" size="28"></app-icon><text>成功关键</text></view>
        <view wx:if="{{recipe.isDraft}}" class="draft-warning">
          <view class="warning-icon"><app-icon name="alert-triangle" size="34"></app-icon></view>
          <view>
            <text class="warning-title">还没有记录成功关键</text>
            <text class="warning-copy">补充至少一条，这道做法才能正式存入食谱库。</text>
          </view>
        </view>
        <view wx:else class="success-list">
          <view wx:for="{{recipe.successKeys}}" wx:key="index" class="success-key">
            <text class="font-serif">{{item}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{recipe.mainImage}}" class="main-photo-wrap">
        <view wx:if="{{recipe.mainImage.loadError}}" class="image-error main-image-error" role="button" data-kind="main" bindtap="retryImage">
          <text>图片加载失败</text><text class="retry-link">重新加载</text>
        </view>
        <image
          wx:else
          class="main-photo"
          src="{{recipe.mainImage.src}}"
          mode="aspectFill"
          data-kind="main"
          data-file-id="{{recipe.mainImage.fileId}}"
          bindtap="previewImage"
          binderror="onImageError"
        ></image>
      </view>

      <view wx:if="{{recipe.ingredients.length > 0}}" class="detail-section">
        <view class="section-label"><app-icon name="shopping-bag" size="28"></app-icon><text>食材</text></view>
        <view class="ingredient-row" wx:for="{{recipe.ingredients}}" wx:key="index">
          <text>{{item.name}}</text><text class="ingredient-amount">{{item.amount || '—'}}</text>
        </view>
      </view>

      <view wx:if="{{recipe.steps.length > 0}}" class="detail-section steps-section">
        <view class="section-label"><app-icon name="list" size="28"></app-icon><text>步骤</text></view>
        <view wx:for="{{recipe.steps}}" wx:key="id" class="step-row">
          <text class="step-number">{{index + 1}}</text>
          <view class="step-body">
            <text class="step-copy">{{item.text}}</text>
            <view wx:if="{{item.image}}" class="step-photo-wrap">
              <view wx:if="{{item.image.loadError}}" class="image-error step-image-error" role="button" data-kind="step" data-index="{{index}}" bindtap="retryImage">
                <text>图片加载失败</text><text class="retry-link">重新加载</text>
              </view>
              <image
                wx:else
                class="step-photo"
                src="{{item.image.src}}"
                mode="aspectFill"
                lazy-load
                data-kind="step"
                data-index="{{index}}"
                data-file-id="{{item.image.fileId}}"
                bindtap="previewImage"
                binderror="onImageError"
              ></image>
            </view>
          </view>
        </view>
      </view>

      <view class="footnote">由 {{recipe.createdName}} 创建 · 家庭共同拥有 · {{recipe.relativeUpdated}}更新</view>
      <view class="archive-row">
        <view class="archive-link" role="button" bindtap="askArchive">{{archiving ? '正在移入…' : '移入废纸篓'}}</view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{found && recipe}}" class="action-bar">
    <view class="secondary-button compact-button" role="button" bindtap="openComments">
      <app-icon name="message-circle" size="30"></app-icon>
      <text>评论{{recipe.commentCountLabel ? ' ' + recipe.commentCountLabel : ''}}</text>
    </view>
    <view class="secondary-button compact-button" role="button" bindtap="duplicate">
      <app-icon name="copy" size="30"></app-icon>
      <text>{{duplicating ? '复制中…' : '复制'}}</text>
    </view>
    <view class="primary-button edit-button" role="button" bindtap="editRecipe">{{recipe.isDraft ? '补充成功关键' : '完善食谱'}}</view>
  </view>
  <confirm-panel
    visible="{{archiveConfirm}}"
    title="移入废纸篓？"
    copy="食谱会从家庭列表隐藏，正文和修订记录仍会保留。"
    note="之后可以随时在 设置-废纸篓 恢复。"
    confirm-text="{{archiving ? '正在移入…' : '确认移入'}}"
    danger
    bindconfirm="confirmArchive"
    bindcancel="cancelArchive"
  ></confirm-panel>
  <app-toast visible="{{toastVisible}}" message="{{toastMessage}}"></app-toast>
</view>
