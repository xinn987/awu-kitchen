<view class="navbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="navbar-row" style="height: {{barHeight}}px;">
    <view class="navbar-side navbar-left" role="button" bindtap="onLeft">
      <app-icon name="chevron-left" size="32"></app-icon><text>{{leftText}}</text>
    </view>
    <view class="navbar-center">
      <text wx:if="{{title}}" class="navbar-title">{{title}}</text>
      <text wx:if="{{subtitle}}" class="navbar-subtitle">{{subtitle}}</text>
    </view>
    <!-- 顶部右侧不放业务操作，并保留等宽槽位让标题以屏幕为基准居中。 -->
    <view class="navbar-side navbar-placeholder"></view>
  </view>
</view>
