<view wx:if="{{mounted}}" class="sheet-layer {{open ? 'open' : ''}}" bindtap="onMaskTap">
  <view class="sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <text class="sheet-title">{{title}}</text>
      <view class="sheet-close" role="button" aria-label="关闭" bindtap="close">
        <app-icon name="x" size="32"></app-icon>
      </view>
    </view>
    <slot></slot>
  </view>
</view>
