<view wx:if="{{mounted}}" class="sheet-layer {{open ? 'open' : ''}}" bindtap="close">
  <view class="sheet" catchtap="noop">
    <view class="sheet-handle"></view>

    <view wx:if="{{step === 'choice'}}" class="sheet-body">
      <view class="sheet-header">
        <text class="sheet-title">添加食谱</text>
        <view class="close-button" role="button" aria-label="关闭" bindtap="close">
          <app-icon name="x" size="38"></app-icon>
        </view>
      </view>
      <view class="create-options">
        <view class="create-option primary" role="button" bindtap="chooseQuick">
          <view class="create-option-icon"><app-icon name="pencil" size="38"></app-icon></view>
          <view class="create-option-copy">
            <text class="create-option-title">快速记录</text>
            <text class="create-option-help">先记下名称和成功关键，其他内容以后再补</text>
          </view>
          <app-icon name="chevron-right" size="30"></app-icon>
        </view>
        <view class="create-option" role="button" bindtap="chooseImport">
          <view class="create-option-icon"><app-icon name="image" size="38"></app-icon></view>
          <view class="create-option-copy">
            <text class="create-option-title">从图片导入</text>
            <text class="create-option-help">选择食谱截图，由 AI 识别并预填编辑页</text>
          </view>
          <app-icon name="chevron-right" size="30"></app-icon>
        </view>
      </view>
    </view>

    <view wx:elif="{{step === 'name'}}" class="sheet-body">
      <view class="sheet-header">
        <view class="back-button" role="button" aria-label="返回添加方式" bindtap="back">
          <app-icon name="chevron-left" size="40"></app-icon>
        </view>
        <text class="sheet-title sheet-title-center">快速记录</text>
        <view class="close-button" role="button" aria-label="关闭" bindtap="close">
          <app-icon name="x" size="38"></app-icon>
        </view>
      </view>
      <text class="sheet-label">食谱名称</text>
      <input
        class="name-input"
        value="{{name}}"
        placeholder="这道辅食叫什么？"
        placeholder-class="input-placeholder"
        focus="{{open && step === 'name'}}"
        bindinput="onNameInput"
        bindconfirm="next"
      />
      <view class="sheet-primary {{!nameFilled ? 'disabled' : ''}}" role="button" bindtap="next">下一步</view>
    </view>

    <view wx:else class="sheet-body">
      <view class="sheet-header">
        <view class="back-button" role="button" aria-label="返回上一步" bindtap="back">
          <app-icon name="chevron-left" size="40"></app-icon>
        </view>
        <text class="recipe-name font-serif">{{name}}</text>
        <view class="close-button" role="button" aria-label="关闭" bindtap="close">
          <app-icon name="x" size="38"></app-icon>
        </view>
      </view>
      <text class="sheet-label">这次做成功，关键在哪里？</text>
      <textarea
        class="key-input"
        value="{{keyText}}"
        placeholder="{{example}}"
        placeholder-class="input-placeholder"
        maxlength="-1"
        auto-height
        bindinput="onKeyInput"
      ></textarea>
      <text class="sheet-help">食材和步骤可以之后再补；有了成功关键，这道做法才算真正留下来了。</text>
      <view class="sheet-primary {{!keyFilled ? 'disabled' : ''}}" role="button" bindtap="saveFormal">正式存入食谱库</view>
      <view class="draft-button" role="button" bindtap="saveDraft">暂存为待补条目，稍后补充</view>
    </view>
  </view>
</view>
