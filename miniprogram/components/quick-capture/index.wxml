<view wx:if="{{opened}}" class="sheet-layer" bindtap="close">
  <view class="sheet" catchtap="noop">
    <view class="sheet-handle"></view>

    <view wx:if="{{step === 'name'}}" class="sheet-body">
      <view class="sheet-header">
        <text class="sheet-title">收录一道新做法</text>
        <view class="close-button" role="button" aria-label="关闭" bindtap="close">×</view>
      </view>
      <text class="sheet-label">食谱名称</text>
      <input
        class="name-input"
        value="{{name}}"
        placeholder="这道辅食叫什么？"
        placeholder-class="input-placeholder"
        focus="{{opened}}"
        bindinput="onNameInput"
        bindconfirm="next"
      />
      <view class="sheet-primary {{!nameFilled ? 'disabled' : ''}}" role="button" bindtap="next">下一步</view>
    </view>

    <view wx:else class="sheet-body">
      <view class="sheet-header">
        <view class="back-button" role="button" aria-label="返回上一步" bindtap="back">‹</view>
        <text class="recipe-name font-serif">{{name}}</text>
        <view class="close-button" role="button" aria-label="关闭" bindtap="close">×</view>
      </view>
      <text class="sheet-label">这次做成功，关键在哪里？</text>
      <textarea
        class="key-input"
        value="{{keyText}}"
        placeholder="{{example}}"
        placeholder-class="input-placeholder"
        maxlength="-1"
        auto-height
        bindinput="onKeyInput"
      ></textarea>
      <text class="sheet-help">食材和步骤可以之后再补；有了成功关键，这道做法才算真正留下来了。</text>
      <view class="sheet-primary {{!keyFilled ? 'disabled' : ''}}" role="button" bindtap="saveFormal">正式存入食谱库</view>
      <view class="draft-button" role="button" bindtap="saveDraft">暂存为待补条目，稍后补充</view>
    </view>
  </view>
</view>
