<view class="tabbar">
  <view class="tab {{active === 'library' ? 'active' : ''}}" bindtap="goLibrary">
    <app-icon name="books" size="42"></app-icon>
    <text>食谱库</text>
  </view>
  <view class="tab {{active === 'journal' ? 'active' : ''}}" bindtap="goJournal">
    <app-icon name="journal" size="42"></app-icon>
    <text>食记</text>
  </view>
  <view class="tab-center">
    <view class="capture-button" bindtap="capture" aria-label="添加食谱">
      <!-- 两条等长线段按圆心绝对定位，避免字体或组件行盒造成视觉偏移。 -->
      <view class="capture-plus" aria-hidden="true">
        <view class="plus-stroke plus-horizontal"></view>
        <view class="plus-stroke plus-vertical"></view>
      </view>
    </view>
  </view>
  <view class="tab {{active === 'family' ? 'active' : ''}}" bindtap="goFamily">
    <app-icon name="users" size="42"></app-icon>
    <text>家庭</text>
  </view>
  <view class="tab {{active === 'settings' ? 'active' : ''}}" bindtap="goSettings">
    <app-icon name="settings" size="42"></app-icon>
    <text>设置</text>
  </view>
</view>
